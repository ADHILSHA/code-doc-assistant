# Copy to backend/.env and fill in.

# --- LLM (synthesis + summarization) ---
ANTHROPIC_API_KEY=

# --- Embeddings ---
# "voyage" (default, code-specialized, requires VOYAGE_API_KEY) | "openai" (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- Paths ---
DATA_DIR=../data

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Security ---
# Off by default: POST /api/repos only accepts GitHub URLs. "local path"
# means local to this *server's* filesystem, not the caller's — leaving
# this on for anything but a trusted single-user local setup lets anyone
# who can reach the API ask the server to index arbitrary files it can read
# (SSH keys, .env files, etc). Set true only for local single-user dev use.
ALLOW_LOCAL_REPOS=false

# --- Guardrails ---
MAX_CHUNKS_PER_REPO=50000
MAX_REPO_SIZE_MB=500
CLONE_TIMEOUT_SECONDS=120

# --- Credentials (private-repo auth via a GitHub PAT, stored encrypted at
# rest — see app/security/credentials.py) ---
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required before POST /api/auth/github-token will work; leave the app
# usable without it for public repos.
CREDENTIAL_ENCRYPTION_KEY=

# --- Request hardening ---
# Requests/minute per client IP, applied only to the expensive endpoints
# (POST /api/query, /api/eval/run, /api/repos*) — 0 disables rate limiting.
RATE_LIMIT_REQUESTS_PER_MINUTE=30
# Wall-clock cap (seconds) on a single HTTP request; /api/query and
# /api/eval/run get the longer budget below instead.
REQUEST_TIMEOUT_SECONDS=30
LONG_REQUEST_TIMEOUT_SECONDS=120

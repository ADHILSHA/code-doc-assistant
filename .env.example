# Copy to backend/.env and fill in.

# --- LLM (synthesis + summarization) ---
ANTHROPIC_API_KEY=

# --- Embeddings ---
# "voyage" (default, requires VOYAGE_API_KEY) | "openai" (requires OPENAI_API_KEY) | "fastembed" (local, offline)
EMBEDDING_PROVIDER=fastembed
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- Paths ---
DATA_DIR=../data

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Guardrails ---
MAX_CHUNKS_PER_REPO=50000
MAX_REPO_SIZE_MB=500
CLONE_TIMEOUT_SECONDS=120
